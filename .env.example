# Copy to `.env.local` for local development.
#
# Client-side (Expo) only exposes variables prefixed with `EXPO_PUBLIC_`.

# Expo + Convex (required)
EXPO_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ElevenLabs (optional, client-side agent sessions)
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# --- Server-side (Convex) secrets ---
# Set these via `npx convex env set` (or the Convex dashboard), not in client code.

# OpenAI (STT + parsing in `convex/actions.ts`)
# OPENAI_API_KEY=

# ElevenLabs (TTS in `convex/actions.ts`)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_USE_SPEAKER_BOOST=true

# Resemble (legacy fallback TTS in `convex/actions.ts`)
# RESEMBLE_API_KEY=
# RESEMBLE_PROJECT_UUID=
# RESEMBLE_VOICE_UUID=
