# Copy to `.env.local` for local development.
#
# Client-side (Expo) only exposes variables prefixed with `EXPO_PUBLIC_`.

# Expo + Convex (required)
EXPO_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ElevenLabs (optional, client-side agent sessions)
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# --- Server-side (Convex) secrets ---
# Set these via `npx convex env set` (or the Convex dashboard), not in client code.

# OpenRouter (STT + parsing in `convex/stt.ts` and `convex/actions.ts`)
# One key covers primary STT (openai/gpt-4o-mini-transcribe), its one-shot
# fallback (openai/whisper-1) and the parse model.
# OPENROUTER_API_KEY=
#
# STT_MODEL (optional) — override the primary STT model slug. Unset or empty
# falls through to the default openai/gpt-4o-mini-transcribe.
# STT_MODEL=openai/gpt-4o-mini-transcribe

# OpenAI (legacy) — still a deployment secret, but the three STT paths no longer
# read it; they use OPENROUTER_API_KEY above.
# OPENAI_API_KEY=

# ElevenLabs (TTS in `convex/actions.ts`)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_USE_SPEAKER_BOOST=true

# Resemble (legacy fallback TTS in `convex/actions.ts`)
# RESEMBLE_API_KEY=
# RESEMBLE_PROJECT_UUID=
# RESEMBLE_VOICE_UUID=
