    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A8A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.wahabbasa.VoiceReminder",
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Remi records your voice so you can create reminders by speaking. Your recording leaves your device and is processed by secure AI services to transcribe it and speak your reminders back to you."
        }
      ],
      "./plugins/withNotifeeAndroidMaven",
      "./plugins/withAndroidSigning",
      "./plugins/withFullScreenAlarm",
      "./plugins/withArmOnlyBuild",
      "./plugins/withAlarmAudioModule",
      "./plugins/withAlarmKit",
      "./plugins/withVRSpeech",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "oldowan"
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3D8BFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d6a3c27-6a3e-4d99-9d5d-85f39d90aa01"
