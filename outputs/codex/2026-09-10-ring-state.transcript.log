lib/store.ts:483:        if (updatedHistory.length > MAX_HISTORY_ENTRIES) {
lib/store.ts:484:            updatedHistory = updatedHistory.slice(-MAX_HISTORY_ENTRIES);
lib/store.ts:485:        }
lib/store.ts:486:
lib/store.ts:487:        // Update state immediately (optimistic)
lib/store.ts:488:        set({ history: updatedHistory });
lib/store.ts:489:
lib/store.ts:490:        // Persist to storage
lib/store.ts:491:        try {
