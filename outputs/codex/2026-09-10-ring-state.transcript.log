lib/time.ts:517:export function formatNextIn(targetMs: number, nowMs: number): string {
lib/time.ts:518:  const diffMs = Math.max(0, targetMs - nowMs);
lib/time.ts:519:  const minutes = Math.max(1, Math.ceil(diffMs / 60000));
lib/time.ts:520:  if (minutes < 60) return `Next in ${minutes} min`;
lib/time.ts:521:  const hours = Math.ceil(minutes / 60);
lib/time.ts:522:  if (diffMs < 86_400_000) return `Next in ${hours} hour${hours !== 1 ? "s" : ""}`;
lib/time.ts:523:  const days = Math.ceil(hours / 24);
lib/time.ts:524:  return `Next in ${days} day${days !== 1 ? "s" : ""}`;
lib/time.ts:525:}
