lib/alarmKit.ts:386:
lib/alarmKit.ts:387:export type AlarmOutcomeKind =
lib/alarmKit.ts:388:  | "completed"
lib/alarmKit.ts:389:  | "snoozed"
lib/alarmKit.ts:390:  | "missed"
lib/alarmKit.ts:391:  | "pending"
lib/alarmKit.ts:392:  /** An alarm the native intents killed instead of the user answering it. */
lib/alarmKit.ts:393:  | "cancelled";
lib/alarmKit.ts:394:
lib/alarmKit.ts:395:export interface AlarmReconcileOutcome {
lib/alarmKit.ts:396:  id: string;
lib/alarmKit.ts:397:  outcome: AlarmOutcomeKind;
lib/alarmKit.ts:398:  snoozeUntil?: number;
lib/alarmKit.ts:399:  /** False while a guard blocks schedule recalculation (PRD guard 3). */
lib/alarmKit.ts:400:  allowReschedule: boolean;
lib/alarmKit.ts:401:}
lib/alarmKit.ts:402:
lib/alarmKit.ts:403:/**
lib/alarmKit.ts:404: * Collapse a drained native event log into one outcome per app key.
lib/alarmKit.ts:405: *
lib/alarmKit.ts:406: * Pure and side-effect free â€” lib/notifications.ts applies the outcomes. The
lib/alarmKit.ts:407: * FamWake race guards live here:
lib/alarmKit.ts:408: *  - guard 2: iOS fires StopIntent even when the user tapped Snooze, so any
lib/alarmKit.ts:409: *    stop landing inside the snooze window is discarded.
lib/alarmKit.ts:410: *  - guard 3: a snooze whose window is still open blocks rescheduling; the
lib/alarmKit.ts:411: *    native side already registered the follow-up.
lib/alarmKit.ts:412: *
lib/alarmKit.ts:413: * A natively cancelled alarm collapses to "cancelled": whatever cancelled it
lib/alarmKit.ts:414: * already recorded the outcome and drove the reschedule, so this key must
lib/alarmKit.ts:415: * produce neither a history entry nor a new occurrence.
lib/alarmKit.ts:416: */
lib/alarmKit.ts:417:export function reconcileAlarmEvents(
lib/alarmKit.ts:418:  events: unknown[],
lib/alarmKit.ts:419:  now: number,
lib/alarmKit.ts:420:  ringTimeoutMs: number = ALARM_RING_TIMEOUT_MS
lib/alarmKit.ts:421:): AlarmReconcileOutcome[] {
lib/alarmKit.ts:422:  const order: string[] = [];
lib/alarmKit.ts:423:  const byId = new Map<string, AlarmEvent[]>();
lib/alarmKit.ts:424:
lib/alarmKit.ts:425:  for (const value of events) {
lib/alarmKit.ts:426:    const raw = toAlarmEvent(value);
lib/alarmKit.ts:427:    if (!raw) continue;
lib/alarmKit.ts:428:    if (!byId.has(raw.id)) {
lib/alarmKit.ts:429:      byId.set(raw.id, []);
lib/alarmKit.ts:430:      order.push(raw.id);
lib/alarmKit.ts:431:    }
lib/alarmKit.ts:432:    byId.get(raw.id)!.push(raw);
lib/alarmKit.ts:433:  }
lib/alarmKit.ts:434:
lib/alarmKit.ts:435:  return order.map((id) => {
lib/alarmKit.ts:436:    const list = byId.get(id)!.slice().sort((a, b) => a.at - b.at);
lib/alarmKit.ts:437:    const snooze = [...list].reverse().find((e) => e.type === "snoozed");
lib/alarmKit.ts:438:    const snoozeUntil = snooze?.snoozeUntil;
lib/alarmKit.ts:439:    const snoozeActive = snoozeUntil !== undefined && now < snoozeUntil;
lib/alarmKit.ts:440:
lib/alarmKit.ts:441:    const realStop = list.find((e) => {
lib/alarmKit.ts:442:      if (e.type !== "stopped") return false;
lib/alarmKit.ts:443:      if (!snooze) return true;
lib/alarmKit.ts:444:      const from = snooze.at - SPURIOUS_STOP_TOLERANCE_MS;
lib/alarmKit.ts:445:      const to = snoozeUntil ?? snooze.at + SPURIOUS_STOP_TOLERANCE_MS;
lib/alarmKit.ts:446:      return !(e.at >= from && e.at < to);
lib/alarmKit.ts:447:    });
lib/alarmKit.ts:448:
lib/alarmKit.ts:449:    const lastFired = [...list].reverse().find((e) => e.type === "fired");
lib/alarmKit.ts:450:    const firedAfterSnooze = lastFired && (!snooze || lastFired.at >= snooze.at);
lib/alarmKit.ts:451:
lib/alarmKit.ts:452:    // A cancel that landed after the last ring wins over "it rang unanswered":
lib/alarmKit.ts:453:    // the alarm was killed on purpose, not ignored.
lib/alarmKit.ts:454:    const lastCancelled = [...list].reverse().find((e) => e.type === "cancelled");
lib/alarmKit.ts:455:    const cancelledLast = lastCancelled && (!lastFired || lastCancelled.at >= lastFired.at);
lib/alarmKit.ts:456:
lib/alarmKit.ts:457:    let outcome: AlarmOutcomeKind;
lib/alarmKit.ts:458:    if (realStop) {
lib/alarmKit.ts:459:      outcome = "completed";
lib/alarmKit.ts:460:    } else if (cancelledLast) {
lib/alarmKit.ts:461:      outcome = "cancelled";
lib/alarmKit.ts:462:    } else if (firedAfterSnooze) {
lib/alarmKit.ts:463:      outcome = now - lastFired!.at >= ringTimeoutMs ? "missed" : "pending";
lib/alarmKit.ts:464:    } else {
lib/alarmKit.ts:465:      outcome = "snoozed";
lib/alarmKit.ts:466:    }
lib/alarmKit.ts:467:
lib/alarmKit.ts:468:    const inert = outcome === "pending" || outcome === "cancelled";
lib/alarmKit.ts:469:    return {
lib/alarmKit.ts:470:      id,
lib/alarmKit.ts:471:      outcome,
lib/alarmKit.ts:472:      allowReschedule: inert ? false : !snoozeActive,
lib/alarmKit.ts:473:      ...(snoozeUntil !== undefined ? { snoozeUntil } : {}),
lib/alarmKit.ts:474:    };
lib/alarmKit.ts:475:  });
lib/alarmKit.ts:476:}
