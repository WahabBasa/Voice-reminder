lib/alarmKit.ts:308: * Per-reminder AlarmKit guard state, written by lib/notifications.ts when a
lib/alarmKit.ts:309: * ring is answered with "Later" and cleared when the reminder completes or is
lib/alarmKit.ts:310: * rescheduled. The key literal is repeated here instead of imported so a card
lib/alarmKit.ts:311: * can read the snooze window without dragging the notification layer (and
lib/alarmKit.ts:312: * notifee with it) into a render path. This module only ever reads it.
lib/alarmKit.ts:313: */
lib/alarmKit.ts:314:const ALARMKIT_STATE_KEY = "@alarmkit_state";
lib/alarmKit.ts:315:
lib/alarmKit.ts:316:/** reminderId -> snoozeUntil (epoch ms). In-memory mirror of the stored state. */
lib/alarmKit.ts:317:let snoozeWindows = new Map<string, number>();
lib/alarmKit.ts:318:let snoozeRefresh: Promise<void> | null = null;
lib/alarmKit.ts:319:
lib/alarmKit.ts:320:function parseSnoozeWindows(raw: string | null): Map<string, number> {
lib/alarmKit.ts:321:  const windows = new Map<string, number>();
lib/alarmKit.ts:322:  if (!raw) return windows;
lib/alarmKit.ts:323:  let parsed: unknown;
lib/alarmKit.ts:324:  try {
lib/alarmKit.ts:325:    parsed = JSON.parse(raw);
lib/alarmKit.ts:326:  } catch {
lib/alarmKit.ts:327:    return windows;
lib/alarmKit.ts:328:  }
lib/alarmKit.ts:329:  if (!parsed || typeof parsed !== "object") return windows;
lib/alarmKit.ts:330:  for (const [reminderId, state] of Object.entries(parsed as Record<string, unknown>)) {
lib/alarmKit.ts:331:    const until = Number((state as { snoozeUntil?: unknown } | null)?.snoozeUntil ?? 0);
lib/alarmKit.ts:332:    // 0 is how a cleared window is stored â€” the reminder is back on schedule.
lib/alarmKit.ts:333:    if (Number.isFinite(until) && until > 0) windows.set(reminderId, until);
lib/alarmKit.ts:334:  }
lib/alarmKit.ts:335:  return windows;
lib/alarmKit.ts:336:}
lib/alarmKit.ts:337:
lib/alarmKit.ts:338:/**
lib/alarmKit.ts:339: * Reload the mirror from storage so {@link getSnoozeUntil} can answer
lib/alarmKit.ts:340: * synchronously. Callers await this before a re-render; the mirror is replaced
lib/alarmKit.ts:341: * wholesale, so a window that was cleared disappears with the same read.
lib/alarmKit.ts:342: *
lib/alarmKit.ts:343: * Concurrent calls share one read, and a failed read keeps the previous mirror
lib/alarmKit.ts:344: * rather than blanking every card.
lib/alarmKit.ts:345: */
lib/alarmKit.ts:346:export function refreshSnoozeWindows(): Promise<void> {
lib/alarmKit.ts:347:  if (snoozeRefresh) return snoozeRefresh;
lib/alarmKit.ts:348:  const task = (async () => {
lib/alarmKit.ts:349:    // Only the AlarmKit path ever writes this state; elsewhere the read is
lib/alarmKit.ts:350:    // guaranteed empty, so skip the storage hop entirely.
lib/alarmKit.ts:351:    if (!isAlarmKitLinked()) {
lib/alarmKit.ts:352:      snoozeWindows = new Map();
lib/alarmKit.ts:353:      return;
lib/alarmKit.ts:354:    }
lib/alarmKit.ts:355:    try {
lib/alarmKit.ts:356:      snoozeWindows = parseSnoozeWindows(await AsyncStorage.getItem(ALARMKIT_STATE_KEY));
lib/alarmKit.ts:357:    } catch (e) {
lib/alarmKit.ts:358:      vrLog("alarmkit", "snooze_read_failed", { error: String(e) });
lib/alarmKit.ts:359:    }
lib/alarmKit.ts:360:  })().finally(() => {
lib/alarmKit.ts:361:    if (snoozeRefresh === task) snoozeRefresh = null;
lib/alarmKit.ts:362:  });
lib/alarmKit.ts:363:  snoozeRefresh = task;
lib/alarmKit.ts:364:  return task;
lib/alarmKit.ts:365:}
lib/alarmKit.ts:366:
lib/alarmKit.ts:367:/**
lib/alarmKit.ts:368: * When a snooze comeback â€” not the schedule â€” owns this reminder's next ring.
lib/alarmKit.ts:369: *
lib/alarmKit.ts:370: * Synchronous because it is read while a card renders. Undefined when the
lib/alarmKit.ts:371: * reminder is not snoozed, or when the comeback is already in the past: it has
lib/alarmKit.ts:372: * rung, and the schedule owns the reminder again.
lib/alarmKit.ts:373: */
lib/alarmKit.ts:374:export function getSnoozeUntil(reminderId: string, nowMs: number): number | undefined {
lib/alarmKit.ts:375:  const until = snoozeWindows.get(reminderId);
lib/alarmKit.ts:376:  return until !== undefined && until > nowMs ? until : undefined;
lib/alarmKit.ts:377:}
lib/alarmKit.ts:378:
lib/alarmKit.ts:379:/** Test seam â€” empties the mirror and drops any in-flight reload. */
lib/alarmKit.ts:380:export function resetSnoozeWindows(): void {
lib/alarmKit.ts:381:  snoozeWindows = new Map();
lib/alarmKit.ts:382:  snoozeRefresh = null;
lib/alarmKit.ts:383:}
