lib/notificationDecisions.ts:276:// â”€â”€â”€ Group 8: The snooze-nag (OLD-96) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
lib/notificationDecisions.ts:277://
lib/notificationDecisions.ts:278:// One ring per occurrence, then a fixed nag. A ring the user dismisses â€” or
lib/notificationDecisions.ts:279:// never answers â€” comes back with the SAME audio NAG_DELAY_MINUTES later, at
lib/notificationDecisions.ts:280:// most MAX_NAG_COMEBACKS times, then goes quiet. "Done" ends the chain and
lib/notificationDecisions.ts:281:// resets the counter.
lib/notificationDecisions.ts:282://
lib/notificationDecisions.ts:283:// Deliberately fixed: no per-reminder tuning, no settings screen, no escalating
lib/notificationDecisions.ts:284:// re-worded lines. This is the whole escalation policy â€” it replaces the
lib/notificationDecisions.ts:285:// tier-dependent sibling ladder and the persistent-follow-up counters, which
lib/notificationDecisions.ts:286:// were the wrong voice for the product.
lib/notificationDecisions.ts:287:
lib/notificationDecisions.ts:288:/** Minutes between a ring going unanswered and its comeback. */
lib/notificationDecisions.ts:289:export const NAG_DELAY_MINUTES = 5;
lib/notificationDecisions.ts:290:
lib/notificationDecisions.ts:291:/** Comebacks a single ring gets before the chain goes quiet. */
lib/notificationDecisions.ts:292:export const MAX_NAG_COMEBACKS = 3;
lib/notificationDecisions.ts:293:
lib/notificationDecisions.ts:294:/** Comebacks already delivered for this ring (notification data / alarm state). */
lib/notificationDecisions.ts:295:export function parseNagCount(value: unknown): number {
lib/notificationDecisions.ts:296:  return Math.max(0, Number(value ?? "0") || 0);
lib/notificationDecisions.ts:297:}
lib/notificationDecisions.ts:298:
lib/notificationDecisions.ts:299:/** Whether comeback number `nagCount + 1` is still owed. */
lib/notificationDecisions.ts:300:export function shouldNagAgain(
lib/notificationDecisions.ts:301:  nagCount: number,
lib/notificationDecisions.ts:302:  maxComebacks: number = MAX_NAG_COMEBACKS
lib/notificationDecisions.ts:303:): boolean {
lib/notificationDecisions.ts:304:  return nagCount < maxComebacks;
lib/notificationDecisions.ts:305:}
lib/notificationDecisions.ts:306:
lib/notificationDecisions.ts:307:// â”€â”€â”€ Group 8b: the chain as a schedule, not a reaction â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
